DB_URL=jdbc:postgresql://127.0.0.1:5432/partygameonline
DB_USERNAME=partygameonline
DB_PASSWORD=partygameonline
# Only needed temporarily to read legacy AES rows; new passwords use BCrypt.
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for AES-256-GCM bearer tokens. Generate a unique random value with at least 32 characters.
AUTH_TOKEN_KEY=replace-with-a-unique-random-secret-at-least-32-characters
AUTH_TOKEN_TTL=24h
# Legacy cookie authentication is intentionally disabled:
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
